{
  "name": "bedrocklang",
  "version": "1.8.2",
  "description": "BedrockLang %TempSshot@1,8,2% — procedural custom structure generation for Minecraft Bedrock addons.",
  "main": "src/main.ts",
  "bin": {
    "BDL": "bin/BDL.cjs"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx src/main.ts",
    "build:addon": "tsx src/main.ts examples/full.bdl",
    "check": "tsc --noEmit",
    "version:show": "node -p \"require('./package.json').version\"",
    "bdl": "tsx src/cli/commands.ts",
    "ts:check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyeler964-web/BedrockLang.git"
  },
  "keywords": [
    "minecraft",
    "bedrock",
    "addon",
    "compiler",
    "language",
    "bdl",
    "scripting",
    "structures",
    "procedural-generation",
    "cli"
  ],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "uuid": "^14.0.2"
  }
}
