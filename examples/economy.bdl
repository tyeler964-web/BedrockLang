project "TsunaEconomy"
description "Tsuna Economy Foundation generated by BedrockLang"
engine "1.21.0"

script """
import { world, system, Player, CommandPermissionLevel, CustomCommandParamType, CustomCommandStatus, DisplaySlotId, ObjectiveSortOrder } from "@minecraft/server";

const MONEY = "tsuna:money";
const SHARDS = "tsuna:shards";
const START_MONEY = 1000;
const START_SHARDS = 0;
const MONEY_OBJECTIVE = "tsuna_money";
const SHARDS_OBJECTIVE = "tsuna_shards";

let moneyObjective;
let shardsObjective;

function numberValue(value, fallback) {
    return typeof value === "number" && Number.isFinite(value) ? value : fallback;
}

function getMoney(player) {
    return numberValue(player.getDynamicProperty(MONEY), START_MONEY);
}

function getShards(player) {
    return numberValue(player.getDynamicProperty(SHARDS), START_SHARDS);
}

function setMoney(player, value) {
    player.setDynamicProperty(MONEY, Math.max(0, Math.floor(value)));
}

function setShards(player, value) {
    player.setDynamicProperty(SHARDS, Math.max(0, Math.floor(value)));
}

function format(value) {
    return Math.floor(value).toLocaleString();
}

function ensureScoreboards() {
    moneyObjective = world.scoreboard.getObjective(MONEY_OBJECTIVE);
    if (!moneyObjective) moneyObjective = world.scoreboard.addObjective(MONEY_OBJECTIVE, "Money");

    shardsObjective = world.scoreboard.getObjective(SHARDS_OBJECTIVE);
    if (!shardsObjective) shardsObjective = world.scoreboard.addObjective(SHARDS_OBJECTIVE, "Shards");

    try {
        world.scoreboard.setObjectiveAtDisplaySlot(DisplaySlotId.Sidebar, {
            objective: moneyObjective,
            sortOrder: ObjectiveSortOrder.Descending
        });
    } catch (_) {}
}

function setupPlayer(player) {
    try {
        if (player.getDynamicProperty(MONEY) === undefined) setMoney(player, START_MONEY);
        if (player.getDynamicProperty(SHARDS) === undefined) setShards(player, START_SHARDS);
        updatePlayerDisplay(player);
    } catch (error) {
        console.warn("TsunaEconomy setup error: " + error);
    }
}

function updatePlayerDisplay(player) {
    try {
        ensureScoreboards();
        if (player.scoreboardIdentity) {
            moneyObjective.setScore(player.scoreboardIdentity, Math.floor(getMoney(player)));
            shardsObjective.setScore(player.scoreboardIdentity, Math.floor(getShards(player)));
        }
    } catch (error) {
        console.warn("TsunaEconomy scoreboard error: " + error);
    }

    player.onScreenDisplay.setActionBar(
        "TSUNA SMP  |  Money: $" + format(getMoney(player)) + "  |  Shards: ✦" + format(getShards(player))
    );
}

world.afterEvents.playerSpawn.subscribe((event) => {
    if (event.initialSpawn) setupPlayer(event.player);
});

system.runInterval(() => {
    for (const player of world.getAllPlayers()) updatePlayerDisplay(player);
}, 20);

system.beforeEvents.startup.subscribe((init) => {
    const registry = init.customCommandRegistry;

    registry.registerCommand({
        name: "tsuna:money",
        description: "View your money",
        permissionLevel: CommandPermissionLevel.Any,
        cheatsRequired: false
    }, (origin) => {
        const player = origin.sourceEntity;
        if (!(player instanceof Player)) {
            return { status: CustomCommandStatus.Failure, message: "This command can only be used by a player." };
        }
        system.run(() => player.sendMessage("§aMoney: §f$" + format(getMoney(player))));
        return { status: CustomCommandStatus.Success };
    });

    registry.registerCommand({
        name: "tsuna:balance",
        description: "View your money and shards",
        permissionLevel: CommandPermissionLevel.Any,
        cheatsRequired: false
    }, (origin) => {
        const player = origin.sourceEntity;
        if (!(player instanceof Player)) {
            return { status: CustomCommandStatus.Failure, message: "This command can only be used by a player." };
        }
        system.run(() => player.sendMessage(
            "§aMoney: §f$" + format(getMoney(player)) + " §7| §dShards: §f✦" + format(getShards(player))
        ));
        return { status: CustomCommandStatus.Success };
    });

    registry.registerCommand({
        name: "tsuna:pay",
        description: "Pay another player",
        permissionLevel: CommandPermissionLevel.Any,
        cheatsRequired: false,
        mandatoryParameters: [
            { type: CustomCommandParamType.PlayerSelector, name: "target" },
            { type: CustomCommandParamType.Integer, name: "amount" }
        ]
    }, (origin, targets, amount) => {
        const player = origin.sourceEntity;
        if (!(player instanceof Player)) {
            return { status: CustomCommandStatus.Failure, message: "This command can only be used by a player." };
        }

        const target = Array.isArray(targets) ? targets[0] : undefined;
        const value = Math.floor(Number(amount));

        system.run(() => {
            if (!(target instanceof Player)) {
                player.sendMessage("§cPlayer not found.");
                return;
            }
            if (!Number.isFinite(value) || value <= 0) {
                player.sendMessage("§cAmount must be greater than 0.");
                return;
            }
            if (target.id === player.id) {
                player.sendMessage("§cYou cannot pay yourself.");
                return;
            }
            if (getMoney(player) < value) {
                player.sendMessage("§cYou do not have enough money.");
                return;
            }

            setMoney(player, getMoney(player) - value);
            setMoney(target, getMoney(target) + value);
            updatePlayerDisplay(player);
            updatePlayerDisplay(target);

            player.sendMessage("§aPaid §f$" + format(value) + " §ato §f" + target.name + "§a.");
            target.sendMessage("§aReceived §f$" + format(value) + " §afrom §f" + player.name + "§a.");
        });

        return { status: CustomCommandStatus.Success };
    });
});
"""
