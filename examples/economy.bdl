project "TsunaEconomy"
description "Tsuna Economy Foundation generated by BedrockLang"
engine "1.21.0"

script """
import { world, system, Player, CustomCommandPermissionLevel, CustomCommandParamType, CustomCommandStatus } from "@minecraft/server";

const MONEY = "tsuna:money";
const SHARDS = "tsuna:shards";
const START_MONEY = 1000;
const START_SHARDS = 0;

function numberValue(value, fallback) {
    return typeof value === "number" && Number.isFinite(value) ? value : fallback;
}
function getMoney(player) { return numberValue(player.getDynamicProperty(MONEY), START_MONEY); }
function getShards(player) { return numberValue(player.getDynamicProperty(SHARDS), START_SHARDS); }
function setMoney(player, value) { player.setDynamicProperty(MONEY, Math.max(0, Math.floor(value))); }
function setShards(player, value) { player.setDynamicProperty(SHARDS, Math.max(0, Math.floor(value))); }
function format(value) { return Math.floor(value).toLocaleString(); }

function setup(player) {
    if (player.getDynamicProperty(MONEY) === undefined) setMoney(player, START_MONEY);
    if (player.getDynamicProperty(SHARDS) === undefined) setShards(player, START_SHARDS);
    player.onScreenDisplay.setActionBar("TSUNA SMP  |  Money: $" + format(getMoney(player)) + "  |  Shards: ✦" + format(getShards(player)));
}

world.afterEvents.playerSpawn.subscribe((event) => {
    if (event.initialSpawn) setup(event.player);
});

system.runInterval(() => {
    for (const player of world.getAllPlayers()) setup(player);
}, 20);

system.beforeEvents.startup.subscribe((init) => {
    const registry = init.customCommandRegistry;

    registry.registerCommand({
        name: "tsuna:money",
        description: "View your money",
        permissionLevel: CustomCommandPermissionLevel.Any,
        cheatsRequired: false
    }, (origin) => {
        const player = origin.sourceEntity;
        if (!(player instanceof Player)) return { status: CustomCommandStatus.Failure };
        system.run(() => player.sendMessage("§aMoney: §f$" + format(getMoney(player))));
        return { status: CustomCommandStatus.Success };
    });

    registry.registerCommand({
        name: "tsuna:balance",
        description: "View your money and shards",
        permissionLevel: CustomCommandPermissionLevel.Any,
        cheatsRequired: false
    }, (origin) => {
        const player = origin.sourceEntity;
        if (!(player instanceof Player)) return { status: CustomCommandStatus.Failure };
        system.run(() => player.sendMessage("§aMoney: §f$" + format(getMoney(player)) + " §7| §dShards: §f✦" + format(getShards(player))));
        return { status: CustomCommandStatus.Success };
    });

    registry.registerCommand({
        name: "tsuna:pay",
        description: "Pay another player",
        permissionLevel: CustomCommandPermissionLevel.Any,
        cheatsRequired: false,
        mandatoryParameters: [
            { type: CustomCommandParamType.PlayerSelector, name: "target" },
            { type: CustomCommandParamType.Integer, name: "amount" }
        ]
    }, (origin, targets, amount) => {
        const player = origin.sourceEntity;
        if (!(player instanceof Player)) return { status: CustomCommandStatus.Failure };
        const target = Array.isArray(targets) ? targets[0] : undefined;
        const value = Math.floor(Number(amount));
        system.run(() => {
            if (!(target instanceof Player)) return player.sendMessage("§cPlayer not found.");
            if (!Number.isFinite(value) || value <= 0) return player.sendMessage("§cAmount must be greater than 0.");
            if (target.id === player.id) return player.sendMessage("§cYou cannot pay yourself.");
            if (getMoney(player) < value) return player.sendMessage("§cYou do not have enough money.");
            setMoney(player, getMoney(player) - value);
            setMoney(target, getMoney(target) + value);
            player.sendMessage("§aPaid §f$" + format(value) + " §ato §f" + target.name + "§a.");
            target.sendMessage("§aReceived §f$" + format(value) + " §afrom §f" + player.name + "§a.");
        });
        return { status: CustomCommandStatus.Success };
    });
});
"""
