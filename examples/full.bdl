project "EverythingDemo"
description "BedrockLang 1.7.2 major-release showcase"
engine "1.21.0"

event player.join {
    player.message("Welcome to the BedrockLang 1.7.2 demo!")
    broadcast("A player joined.")
}

event player.leave {
    broadcast("A player left.")
}

command "bedrocklang:hello" {
    description "Sends a greeting"
    permission Any
    cheats false
    execute {
        message "Hello from a BedrockLang custom command!"
    }
}

command "bedrocklang:announce" {
    description "Broadcast an announcement"
    permission GameDirectors
    cheats false
    param string message required
    execute {
        broadcast "Announcement command executed."
    }
}

every 5 seconds {
    log "BedrockLang scheduled task is running."
}

item "demo_item" """
{
  "format_version":"1.21.50",
  "minecraft:item":{
    "description":{"identifier":"bedrocklang:demo_item","menu_category":{"category":"items"}},
    "components":{"minecraft:max_stack_size":64,"minecraft:display_name":{"value":"Demo Item"}}
  }
}
"""

block "demo_block" """
{
  "format_version":"1.21.50",
  "minecraft:block":{
    "description":{"identifier":"bedrocklang:demo_block"},
    "components":{"minecraft:destroy_time":1}
  }
}
"""

recipe "demo_recipe" """
{
  "format_version":"1.20.10",
  "minecraft:recipe_shaped":{
    "description":{"identifier":"bedrocklang:demo_recipe"},
    "tags":["crafting_table"],
    "pattern":["AA","AA"],
    "key":{"A":{"item":"minecraft:stone"}},
    "result":{"item":"bedrocklang:demo_item","count":1}
  }
}
"""

loot "demo_loot" """
{
  "pools":[{"rolls":1,"entries":[{"type":"item","name":"bedrocklang:demo_item","weight":1}]}]
}
"""

language "en_US" """
item.bedrocklang.demo_item.name=Demo Item
"""
